{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mkj69.github.io/thoughts-in-passing/schema/thought.schema.json",
  "title": "Thoughts, in Passing entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "slug", "date", "maturity", "tags", "related", "excerpt", "placeholder"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "date": { "type": "string", "format": "date" },
    "maturity": { "enum": ["seed", "sketch", "evolving", "essay"] },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "related": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "excerpt": { "type": "string", "minLength": 1, "maxLength": 280 },
    "placeholder": { "type": "boolean" }
  }
}
